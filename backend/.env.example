# Copie para backend/.env e preencha. Nunca commite o .env.

# --- Obrigatórias ---
# String de conexão do MongoDB Atlas (Database > Connect > Drivers)
MONGO_URI=mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Mínimo 32 caracteres. Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-string-aleatoria-com-pelo-menos-32-caracteres

# --- Opcionais (defaults entre parênteses) ---
DATABASE_NAME=finance_saas_dev
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
# Origens web permitidas (o app desktop Tauri é sempre permitido)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]
# Em produção, deixe true para não expor /api/v1/openapi.json
DISABLE_OPENAPI=false

# --- E-mail (SMTP de qualquer provedor) ---
# Resend:  MAIL_SERVER=smtp.resend.com  MAIL_PORT=587  MAIL_USERNAME=resend  MAIL_PASSWORD=<API key>
# Brevo:   MAIL_SERVER=smtp-relay.brevo.com  MAIL_PORT=587  MAIL_USERNAME=<login>  MAIL_PASSWORD=<smtp key>
# Gmail:   MAIL_SERVER=smtp.gmail.com  MAIL_PORT=587  MAIL_USERNAME=<seu@gmail.com>  MAIL_PASSWORD=<senha de app>
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@seneb.com.br
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
# Em desenvolvimento: true registra o código OTP no log em vez de enviar e-mail.
# (Se MAIL_SERVER estiver vazio, o comportamento já é esse.)
MAIL_DEV_LOG_CODES=true

# --- Runtime (Docker) ---
PORT=8000
WEB_CONCURRENCY=1
