{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Seneb", 
  "version": "0.1.0",
  "identifier": "br.com.seneb.desktop", 
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Seneb - Controle Financeiro",
        "width": 1024, 
        "height": 768,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://finance-control-saas-1efccb.gitlab.io/update.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDRTQ0QjkzRjVDOTY4RjQKUldUMGFNbjFrMHZrUE8yWFRJTllOQWxYVHR1MjFMZWN1bWxmdW0vRSt6Tmxxb2FHUTM3bVYzRFoK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}